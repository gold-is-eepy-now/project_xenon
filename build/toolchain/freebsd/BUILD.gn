# Xenon: FreeBSD toolchains. FreeBSD ships clang/lld/llvm binutils in the base
# system, so the default toolchains are clang-based. Modeled on
# //build/toolchain/linux and the www/chromium port's freebsd toolchain.
#
# Xenon officially targets amd64 (x64) and aarch64 (arm64); x86/arm are provided
# for completeness so host_toolchain selection resolves on those CPUs.

import("//build/config/sysroot.gni")
import("//build/toolchain/gcc_toolchain.gni")

clang_toolchain("clang_x86") {
  toolchain_args = {
    current_cpu = "x86"
    current_os = "freebsd"
  }
}

clang_toolchain("clang_x64") {
  # Output linker map files for binary size analysis.
  enable_linker_map = true

  toolchain_args = {
    current_cpu = "x64"
    current_os = "freebsd"
  }
}

clang_toolchain("clang_arm") {
  toolchain_args = {
    current_cpu = "arm"
    current_os = "freebsd"
  }
}

clang_toolchain("clang_arm64") {
  # Output linker map files for binary size analysis.
  enable_linker_map = true

  toolchain_args = {
    current_cpu = "arm64"
    current_os = "freebsd"
  }
}
